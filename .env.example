# Sem credenciais, o fluxo completo usa dados fictícios e mensagens de modelo.
APP_MODE=demo
HOST=127.0.0.1
PORT=3000
STORAGE_DRIVER=local
DATA_DIR=.data

# Obrigatório para escutar fora de localhost. Use um valor aleatório de 32+ caracteres.
API_AUTH_TOKEN=
PUBLIC_ORIGIN=
# No Render, pode ficar vazio: o servidor usa RENDER_EXTERNAL_URL automaticamente.
# Chave aleatória estável de 32+ caracteres para links assinados de descadastro.
UNSUBSCRIBE_SIGNING_KEY=
CREDENTIAL_ENCRYPTION_KEY=
# Bloqueios independentes. Manter estes valores durante desenvolvimento e validação.
DELIVERY_MODE=dry-run
ENABLE_LIVE_SENDS=false
# Hosts exatos de sites oficiais vinculados aos canais; não use curingas.
CONTACT_ALLOWED_HOSTS=

# APP_MODE=live habilita descoberta real, mas nunca envio de e-mails.
YOUTUBE_API_KEY=
# Também aceita OPENAI_API_KEY; LLM_API_KEY funciona em ambientes que reservam esse nome.
LLM_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OAuth 2.0 para Gmail: gmail.send e gmail.readonly. Não use senha da conta.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# STORAGE_DRIVER=supabase; chave exclusiva do backend, nunca do navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
